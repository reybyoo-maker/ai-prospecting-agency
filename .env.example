# Copy values into GitHub Actions Secrets or local environment; never commit real secrets.
GEMINI_API_KEY=
INGEST_TOKEN=
DASHBOARD_INGEST_URL=https://aigrowth-owner-dashboard.reybyoo.workers.dev/api/ingest/scrape
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_PER_RUN=80
MAX_AI_PER_RUN=60
MAX_DAILY_SENDS=20
MAX_SENDS_PER_RUN=20
MIN_SCORE_TO_SEND=75
CAMPAIGN_NAME=aigrowth-prospecting

# Discovery: business leads + independent professionals with public work-related needs.
QUERIES_PER_RUN=24
INDIVIDUAL_QUERY_RATIO=0.30
SEARCH_BACKENDS=google,brave,bing,duckduckgo
SEARCH_TIMEOUT=25
SEARCH_DDGS_BACKENDS_PER_QUERY=2
DIRECT_SEARCH_MIN_RESULTS=5
DIRECT_SEARCH_PROVIDERS_PER_QUERY=4
DIRECT_SEARCH_TIMEOUT=8
# Optional search APIs / metasearch. Leave empty to keep the free HTML fallbacks.
BRAVE_SEARCH_API_KEY=
SEARXNG_BASE_URLS=
# Optional paid social-profile enrichment; requires explicit opt-in and may consume Apify credits.
APIFY_API_TOKEN=
APIFY_ACTOR_ID=tri_angle~social-media-finder
APIFY_ENRICHMENT_ENABLED=false
APIFY_MAX_NAMES_PER_RUN=15

ENABLE_AUTO_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
